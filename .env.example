# mock = offline demo (no API key). anthropic = real LLM.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high (thinking depth); empty = model default
ANTHROPIC_EFFORT=low
AGENT_NAME=Eric
BRAND_NAME=Starfall Odyssey Support
CORS_ORIGINS=http://localhost:3000
SEED_DEMO=1
# auto = demo history only with the mock provider; 1 = always; 0 = never
SEED_HISTORY=auto
APP_TIMEZONE=Asia/Seoul
